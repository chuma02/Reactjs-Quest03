# ─────────────────────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────────────────────
# Which provider to use.
# Built-in registered values: "openai" | "mock"
# To add a new provider (e.g. "anthropic"), call registerProvider() from
# src/lib/ai/provider.ts and set this variable to the matching key.
AI_PROVIDER=openai

# ─────────────────────────────────────────────────────────────
# OpenAI Authentication
# SECURITY RULES:
#   1. Never commit this file — .env.local is in .gitignore.
#   2. Never expose this key via a NEXT_PUBLIC_ variable.
#   3. Rotate immediately if accidentally committed.
#   4. Keys should start with "sk-" (personal) or "sk-proj-"
#      (project-scoped). Project-scoped keys are preferred for
#      production because they can be restricted by API route.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-with-your-real-key

# Model used for chat and content generation (cost control)
OPENAI_MODEL=gpt-4o-mini

# Model used for safety moderation
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Sampling parameters (lower temperature = more deterministic)
OPENAI_TEMPERATURE=0.4
OPENAI_TOP_P=1

# Maximum tokens per response
OPENAI_MAX_OUTPUT_TOKENS=500

# ─────────────────────────────────────────────────────────────
# Cost & Budget Controls
# ─────────────────────────────────────────────────────────────
# Hard ceiling in USD; requests are rejected once exceeded.
AI_MONTHLY_BUDGET_USD=20

# Log a warning when this % of the budget is consumed (0–100).
AI_BUDGET_ALERT_THRESHOLD_PERCENT=80

# ─────────────────────────────────────────────────────────────
# Data Governance
# ─────────────────────────────────────────────────────────────
AI_DATA_RETENTION_DAYS=30
AI_PII_REDACTION_ENABLED=true
AI_AUDIT_LOGGING_ENABLED=true

# Salt used for anonymising user identifiers in governance logs.
# Change this value; treat it like a secret.
AI_GOVERNANCE_SALT=change-this-to-a-random-string

# ─────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────
AI_MODERATION_ENABLED=true
AI_STREAMING_ENABLED=true

# Gradual rollout percentage for the AI tutor feature (0–100).
FEATURE_AI_TUTOR=true
FEATURE_AI_TUTOR_ROLLOUT_PERCENT=100
FEATURE_AI_SEARCH=true
FEATURE_ADAPTIVE_RECOMMENDATIONS=true
